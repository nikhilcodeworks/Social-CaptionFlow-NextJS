# Server Port & Host (Render sets PORT automatically in production)
PORT=8000
HOST=0.0.0.0
ENV=development

# Whisper Model (Options: tiny, base, small, medium)
# Recommended: 'tiny' for 512MB free tier cloud instances, 'base' for 1GB+ RAM
WHISPER_MODEL=tiny

# CORS Allowed Origins (Comma-separated list of allowed frontend URLs)
# For production, set to your Vercel URL e.g. "https://my-app.vercel.app,http://localhost:3000"
CORS_ORIGINS=*

# Optional Gemini API Key for server-side transcription & translation fallback
GEMINI_API_KEY=

# Groq API Key for Cloud Whisper Large (Fastest, zero local RAM/CPU load)
# Get your free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Video upload limits (Max 3 minutes duration, Max 100 MB file size)
MAX_VIDEO_DURATION_SECONDS=180
MAX_VIDEO_SIZE_MB=100
